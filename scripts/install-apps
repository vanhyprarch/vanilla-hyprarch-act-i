#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Install explicitly selected applications from the reviewed project catalog."""
import argparse
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))
from adapters.catalog import load_catalog


def main():
    catalog = load_catalog()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("applications", nargs="*", metavar="APP")
    parser.add_argument("--list", action="store_true", help="list reviewed applications")
    parser.add_argument("--dry-run", action="store_true", help="show commands without changing anything")
    args = parser.parse_args()
    if args.list or not args.applications:
        for app in catalog.values():
            print(f"{app.id}: {app.name} ({app.flatpak_id})")
        return 0
    unknown = sorted(set(args.applications) - catalog.keys())
    if unknown:
        parser.error("Applications are not in the reviewed catalog: " + ", ".join(unknown))
    if os.geteuid() == 0:
        parser.error("Run as the normal HTPC user; applications are installed per-user")
    selected = list(dict.fromkeys(args.applications))
    commands = [
        ["flatpak", "--user", "remote-add", "--if-not-exists", "flathub",
         "https://dl.flathub.org/repo/flathub.flatpakrepo"],
        ["flatpak", "--user", "install", "--assumeyes", "--noninteractive", "flathub",
         *(catalog[name].flatpak_id for name in selected)],
    ]
    if args.dry_run:
        for command in commands:
            print(shlex.join(command))
        return 0
    if not shutil.which("flatpak"):
        parser.error("Flatpak must be installed on the target first")
    for command in commands:
        subprocess.run(command, check=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"Application installation failed: {error}", file=sys.stderr)
        raise SystemExit(1)
